function animateNum(el, to) {
  const from = parseInt(el.textContent) || 0;
  if (from === to) return;
  const dur = 500, step = 16;
  const diff = to - from, steps = Math.ceil(dur / step);
  let cur = 0;
  const iv = setInterval(() => {
    cur++;
    el.textContent = Math.round(from + diff * (cur / steps));
    if (cur >= steps) { el.textContent = to; clearInterval(iv); }
  }, step);
}

function updateFooterStats() {
  const { total, automation, insight, km } = sessionStats;
  animateNum(document.getElementById('ft-total'), total);
  animateNum(document.getElementById('ft-auto'),  automation);
  animateNum(document.getElementById('ft-ins'),   insight);
  animateNum(document.getElementById('ft-km'),    km);

  // Mini bars
  const maxH = 14;
  const max = Math.max(automation, insight, km, 1);
  document.getElementById('mb-a').style.height = Math.max(2, Math.round(automation/max*maxH)) + 'px';
  document.getElementById('mb-i').style.height = Math.max(2, Math.round(insight/max*maxH))    + 'px';
  document.getElementById('mb-k').style.height = Math.max(2, Math.round(km/max*maxH))         + 'px';

  // Timestamp
  document.getElementById('ft-session-ts').textContent =
    total > 0
      ? `อัปเดต ${new Date().toLocaleTimeString('th-TH',{hour:'2-digit',minute:'2-digit'})}`
      : 'Session นี้';

  // Ticker
  buildTicker();
}

function buildTicker() {
  const h = sessionStats.history;
  if (!h.length) return;

  const wrap = document.getElementById('ft-ticker-wrap');
  const ticker = document.getElementById('ft-ticker');

  const pathColor = { automation:'#a78bfa', insight:'#67e8f9', km:'#93c5fd' };
  const pathIcon  = { automation:'⚙️', insight:'🔮', km:'📚' };

  // Build items × 2 for seamless loop
  const items = h.slice(-10).reverse(); // last 10, newest first
  const html = [...items, ...items].map(r =>
    `<div class="ticker-item">
      <div class="ticker-dot" style="background:${pathColor[r.path]}"></div>
      <span class="ticker-path" style="color:${pathColor[r.path]}">${pathIcon[r.path]} ${PATHS[r.path].name}</span>
      <span class="ticker-sep">·</span>
      <span style="color:rgba(255,255,255,.25);font-size:9px">${r.time}</span>
    </div>`
  ).join('');

  ticker.innerHTML = html;
  wrap.style.display = 'block';

  // Adjust animation speed based on item count
  const speed = Math.max(12, items.length * 3);
  ticker.style.animationDuration = speed + 's';
}

function recordResult(pathKey) {
