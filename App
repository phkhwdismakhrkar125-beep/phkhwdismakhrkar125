
                        <!DOCTYPE html>
                        <html lang="en">
                        <head>
                            <meta charset="UTF-8">
                            <meta name="viewport" content="width=device-width, initial-scale=1.0">
							<style>
								body {
									background-color: white; /* Ensure the iframe has a white background */
								}

								
							</style>
                        </head>
                        <body>
                            <!-- generated HTML -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Sarabun:wght@300;400;500;600;700&family=Share+Tech+Mono&display=swap');

  :root {
    --gold:#f59e0b;--gold-l:#fcd34d;--gold-d:#d97706;
    --purple:#8b5cf6;--purple-l:#c4b5fd;
    --cyan:#06b6d4;--cyan-l:#67e8f9;
    --blue:#3b82f6;--green:#10b981;--bg:#0a0a0f;
  }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  body{font-family:'Sarabun',sans-serif;background:var(--bg);color:#e2e8f0;min-height:100vh;overflow-x:hidden;-webkit-font-smoothing:antialiased}
  #mc{position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;opacity:.18;pointer-events:none}
  .app{position:relative;z-index:1;min-height:100vh;display:flex;flex-direction:column}
  .screen-area{flex:1}
  .screen{display:none;min-height:calc(100vh - 64px);padding:20px 16px;animation:fadeUp .4s ease}
  .screen.active{display:flex;flex-direction:column;align-items:center;justify-content:center}
  @media(max-width:480px){.screen{padding:14px 12px}}

  @keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
  @keyframes spin{to{transform:rotate(360deg)}}
  @keyframes spinR{to{transform:rotate(-360deg)}}
  @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.45}}
  @keyframes glowP{0%,100%{filter:brightness(1)}50%{filter:brightness(1.4)}}
  @keyframes scanline{0%{top:-4%}100%{top:104%}}
  @keyframes slideIn{from{opacity:0;transform:translateX(-10px)}to{opacity:1;transform:translateX(0)}}
  @keyframes pfly{0%{transform:translateY(100vh);opacity:0}10%{opacity:1}90%{opacity:1}100%{transform:translateY(-100vh);opacity:0}}
  @keyframes countUp{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
  @keyframes ticker{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

  .glass{background:rgba(255,255,255,.04);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.09);border-radius:16px}
  .glass-md{background:rgba(255,255,255,.06);backdrop-filter:blur(18px);border:1px solid rgba(255,255,255,.12);border-radius:18px}

  /* BUTTONS */
  .btn{padding:12px 22px;border:none;border-radius:10px;font-family:'Orbitron',monospace;font-size:11px;font-weight:700;cursor:pointer;transition:all .22s;letter-spacing:.7px;position:relative;overflow:hidden;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:5px;white-space:nowrap;min-height:44px}
  .btn::after{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.07),transparent);transition:left .4s}
  .btn:hover::after{left:100%}
  .btn:active{transform:scale(.96)}
  .btn-gold{background:linear-gradient(135deg,var(--gold-d),var(--gold));color:#1a1000;box-shadow:0 0 16px rgba(245,158,11,.35)}
  .btn-gold:hover{box-shadow:0 0 28px rgba(245,158,11,.6);transform:translateY(-2px)}
  .btn-ghost{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.16);color:#e2e8f0}
  .btn-ghost:hover{background:rgba(255,255,255,.09);border-color:var(--gold);transform:translateY(-2px)}
  .btn-danger{background:linear-gradient(135deg,#7c3aed,#db2777);color:#fff}
  .btn-danger:hover{box-shadow:0 0 16px rgba(219,39,119,.4);transform:translateY(-2px)}
  .btn:disabled{opacity:.35;cursor:not-allowed;transform:none!important}
  .btn-group{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}

  .btn-mission{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:14px 28px;border-radius:14px;border:none;cursor:pointer;font-family:'Sarabun',sans-serif;font-size:15px;font-weight:700;color:#fff;text-decoration:none;min-height:52px;background:linear-gradient(135deg,#059669,#10b981);box-shadow:0 4px 20px rgba(16,185,129,.4);transition:all .22s}
  .btn-mission:hover{background:linear-gradient(135deg,#047857,#059669);box-shadow:0 6px 32px rgba(16,185,129,.65);transform:translateY(-2px) scale(1.01)}
  .btn-mission:active{transform:scale(.97)}
  .btn-mission .mi{font-size:19px;flex-shrink:0}
  .btn-mission .mt{line-height:1.25}
  .btn-mission .mt-main{font-size:14px;font-weight:700;display:block}
  .btn-mission .mt-sub{font-size:10px;opacity:.82;display:block;font-weight:400}
  @media(max-width:480px){.btn-mission{width:100%;padding:14px 20px}.btn-group{gap:7px}.btn{font-size:10px;padding:11px 16px}}

  .badge{display:inline-flex;align-items:center;gap:3px;padding:3px 9px;border-radius:20px;font-size:9px;font-family:'Orbitron',monospace;letter-spacing:.8px}
  .b-gold{background:rgba(245,158,11,.13);border:1px solid rgba(245,158,11,.38);color:var(--gold-l)}
  .b-purple{background:rgba(139,92,246,.16);border:1px solid rgba(139,92,246,.38);color:var(--purple-l)}
  .b-cyan{background:rgba(6,182,212,.13);border:1px solid rgba(6,182,212,.38);color:var(--cyan-l)}
  .b-blue{background:rgba(59,130,246,.13);border:1px solid rgba(59,130,246,.38);color:#93c5fd}

  .trans{position:fixed;inset:0;background:radial-gradient(ellipse at center,rgba(245,158,11,.55),rgba(10,10,15,.97));z-index:100;pointer-events:none;opacity:0;transition:opacity .22s}
  .trans.on{opacity:1}
  .part{position:fixed;pointer-events:none;z-index:0;border-radius:50%;animation:pfly linear infinite}
  .divider{width:100%;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.11),transparent);margin:14px 0}

  /* ══════════════════════════════════
     FOOTER STAT BAR
  ══════════════════════════════════ */
  .stat-footer{
    position:relative;z-index:10;
    width:100%;
    background:rgba(10,10,15,.92);
    backdrop-filter:blur(20px);
    border-top:1px solid rgba(245,158,11,.18);
    padding:10px 20px;
  }

  /* Top row: stat chips */
  .stat-footer-inner{
    max-width:1060px;margin:0 auto;
    display:flex;align-items:center;justify-content:space-between;
    gap:12px;flex-wrap:wrap;
  }

  /* Left: chips group */
  .stat-chips{display:flex;align-items:center;gap:8px;flex-wrap:wrap}

  .stat-chip{
    display:inline-flex;align-items:center;gap:5px;
    padding:5px 10px;border-radius:20px;
    font-family:'Share Tech Mono',monospace;font-size:11px;
    transition:all .2s;cursor:default;
    white-space:nowrap;
  }
  .stat-chip-total{
    background:rgba(245,158,11,.12);
    border:1px solid rgba(245,158,11,.3);
    color:var(--gold-l);
  }
  .stat-chip-auto{
    background:rgba(139,92,246,.1);
    border:1px solid rgba(139,92,246,.25);
    color:var(--purple-l);
  }
  .stat-chip-ins{
    background:rgba(6,182,212,.1);
    border:1px solid rgba(6,182,212,.25);
    color:var(--cyan-l);
  }
  .stat-chip-km{
    background:rgba(59,130,246,.1);
    border:1px solid rgba(59,130,246,.25);
    color:#93c5fd;
  }
  .stat-chip-num{
    font-family:'Orbitron',monospace;
    font-size:13px;font-weight:700;
    animation:countUp .4s ease;
  }
  .stat-chip-label{font-size:10px;opacity:.7}

  /* Mini bar chart inside total chip */
  .mini-bars{display:flex;align-items:flex-end;gap:2px;height:14px;margin-left:4px}
  .mini-bar{width:4px;border-radius:2px;transition:height .6s ease}

  /* Right: live indicator */
  .stat-live{
    display:flex;align-items:center;gap:6px;
    font-family:'Share Tech Mono',monospace;font-size:10px;
    color:rgba(255,255,255,.3);
    white-space:nowrap;
  }
  .live-dot{
    width:6px;height:6px;border-radius:50%;
    background:var(--green);
    box-shadow:0 0 6px var(--green);
    animation:pulse .9s ease-in-out infinite;
    flex-shrink:0;
  }

  /* Ticker (scrolling recent activity) */
  .stat-ticker-wrap{
    overflow:hidden;width:100%;
    border-top:1px solid rgba(255,255,255,.05);
    margin-top:8px;padding-top:6px;
  }
  .stat-ticker{
    display:flex;gap:0;
    white-space:nowrap;
    animation:ticker 18s linear infinite;
  }
  .stat-ticker:hover{animation-play-state:paused}
  .ticker-item{
    display:inline-flex;align-items:center;gap:5px;
    font-family:'Share Tech Mono',monospace;font-size:10px;
    color:rgba(255,255,255,.35);
    padding:0 28px 0 0;
  }
  .ticker-dot{width:4px;height:4px;border-radius:50%;flex-shrink:0}
  .ticker-name{color:rgba(255,255,255,.55)}
  .ticker-path{}
  .ticker-sep{color:rgba(255,255,255,.15);margin:0 8px}

  @media(max-width:600px){
    .stat-footer{padding:9px 14px}
    .stat-chips{gap:5px}
    .stat-chip{padding:4px 8px;font-size:10px}
    .stat-chip-num{font-size:12px}
    .stat-chip-label{display:none}
    .stat-ticker-wrap{display:none}
  }

  /* WELCOME */
  #welcome-screen{background:radial-gradient(ellipse at 50% 28%,rgba(245,158,11,.1) 0%,rgba(10,10,15,.9) 65%)}
  .logo-wrap{position:relative;width:96px;height:96px;margin:0 auto 14px}
  .lr{position:absolute;border-radius:50%;border:2px solid transparent}
  .lr1{inset:0;border-top-color:var(--gold);border-right-color:var(--gold);animation:spin 3s linear infinite;box-shadow:0 0 9px var(--gold)}
  .lr2{inset:13px;border-bottom-color:var(--cyan);border-left-color:var(--cyan);animation:spinR 2s linear infinite;box-shadow:0 0 7px var(--cyan)}
  .logo-core{position:absolute;inset:26px;background:radial-gradient(circle,rgba(245,158,11,.7),rgba(139,92,246,.4));border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;animation:glowP 2s ease-in-out infinite;box-shadow:0 0 16px var(--gold)}
  .game-title{font-family:'Orbitron',monospace;font-size:clamp(24px,6vw,46px);font-weight:900;text-align:center;background:linear-gradient(135deg,var(--gold-l),#fff,var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;filter:drop-shadow(0 0 8px rgba(245,158,11,.5));margin-bottom:4px;line-height:1.1}
  .game-sub{font-family:'Share Tech Mono',monospace;font-size:clamp(9px,2.2vw,12px);text-align:center;color:var(--gold);margin-bottom:8px;letter-spacing:2.5px;animation:pulse 3s infinite}
  .game-tagline{font-size:clamp(13px,3.5vw,16px);text-align:center;color:rgba(255,255,255,.58);margin-bottom:22px;line-height:1.7;max-width:460px;padding:0 4px}
  .paths-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;max-width:840px;width:100%;margin-bottom:20px}
  @media(max-width:680px){.paths-grid{grid-template-columns:1fr;gap:8px;max-width:400px}}
  .path-card{padding:14px 12px;border-radius:12px;text-align:center;cursor:default;transition:transform .28s;animation:float 3.5s ease-in-out infinite}
  .path-card:nth-child(2){animation-delay:-1.2s}.path-card:nth-child(3){animation-delay:-2.4s}
  @media(min-width:681px){.path-card:hover{transform:translateY(-4px) scale(1.02)}}
  .pc-auto{background:rgba(139,92,246,.09);border:1px solid rgba(139,92,246,.28)}
  .pc-ins{background:rgba(6,182,212,.07);border:1px solid rgba(6,182,212,.28)}
  .pc-km{background:rgba(59,130,246,.07);border:1px solid rgba(59,130,246,.28)}
  .pc-icon{font-size:24px;margin-bottom:6px}
  .pc-name{font-family:'Orbitron',monospace;font-size:10px;font-weight:700;margin-bottom:3px;letter-spacing:.4px}
  .pc-desc{font-size:11px;opacity:.62;line-height:1.5}
  @media(max-width:680px){
    .path-card{display:flex;align-items:center;gap:12px;text-align:left;padding:12px 14px}
    .pc-icon{font-size:26px;flex-shrink:0;margin:0}
    .pc-content{flex:1}.pc-name{margin-bottom:2px}
  }
  .pc-auto .pc-name{color:var(--purple-l)}.pc-ins .pc-name{color:var(--cyan-l)}.pc-km .pc-name{color:#93c5fd}

  /* QUIZ */
  #quiz-screen{justify-content:flex-start;padding-top:20px}
  .quiz-wrap{width:100%;max-width:680px}
  .qhdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:5px}
  .qlbl{font-family:'Orbitron',monospace;font-size:9px;color:var(--gold);letter-spacing:2px}
  .qnum-txt{font-family:'Share Tech Mono',monospace;font-size:12px;color:var(--purple-l)}
  .prog-track{width:100%;height:5px;background:rgba(255,255,255,.08);border-radius:3px;margin-bottom:16px;overflow:hidden}
  .prog-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,var(--gold-d),var(--gold));box-shadow:0 0 6px var(--gold);transition:width .5s ease}
  .qcard{padding:20px 18px;margin-bottom:14px;border-radius:16px}
  .qid-txt{font-family:'Share Tech Mono',monospace;font-size:9px;color:var(--gold);margin-bottom:6px;letter-spacing:2px}
  .qtext{font-size:clamp(15px,4vw,18px);font-weight:600;line-height:1.65;color:#f1f5f9}
  .opts{display:flex;flex-direction:column;gap:9px;margin-bottom:18px}
  .opt{padding:13px 15px;border-radius:11px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);cursor:pointer;transition:all .22s;display:flex;align-items:center;gap:11px;min-height:52px}
  @media(min-width:481px){.opt:hover{background:rgba(245,158,11,.09);border-color:rgba(245,158,11,.38);transform:translateX(3px)}}
  .opt.sel{background:rgba(245,158,11,.14);border-color:var(--gold);box-shadow:0 0 14px rgba(245,158,11,.25)}
  .opt-mk{width:26px;height:26px;border-radius:50%;border:2px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-family:'Orbitron',monospace;font-size:10px;font-weight:700;flex-shrink:0;transition:all .22s}
  .opt.sel .opt-mk{background:var(--gold);border-color:var(--gold);color:#1a1000;box-shadow:0 0 8px var(--gold)}
  .opt-tx{font-size:clamp(13px,3.5vw,14px);line-height:1.5;flex:1}
  .qnav{display:flex;justify-content:space-between;align-items:center;gap:10px}
  .qnav .btn{flex:1;max-width:160px}

  /* CEREMONY */
  #ceremony-screen{background:radial-gradient(ellipse at center,rgba(245,158,11,.07) 0%,rgba(10,10,15,.96) 70%)}
  .cer-wrap{width:100%;max-width:560px;text-align:center}
  .scan-orb{width:120px;height:120px;margin:0 auto 18px;position:relative}
  .sr1{position:absolute;inset:0;border-radius:50%;border:2px solid transparent;border-top-color:var(--gold);animation:spin 1.4s linear infinite;box-shadow:0 0 10px var(--gold)}
  .sr2{position:absolute;inset:16px;border-radius:50%;border:2px solid transparent;border-bottom-color:var(--purple);animation:spinR .9s linear infinite;box-shadow:0 0 8px var(--purple)}
  .sr3{position:absolute;inset:32px;border-radius:50%;border:2px solid transparent;border-top-color:var(--cyan-l);border-right-color:var(--cyan-l);animation:spin .7s linear infinite}
  .scan-core{position:absolute;inset:44px;background:radial-gradient(circle,var(--gold),var(--purple));border-radius:50%;box-shadow:0 0 20px var(--gold);animation:pulse .7s ease-in-out infinite;display:flex;align-items:center;justify-content:center;font-size:16px}
  .laser-scan{position:fixed;left:0;width:100%;height:2px;background:linear-gradient(90deg,transparent,var(--gold),var(--cyan),var(--gold),transparent);box-shadow:0 0 6px var(--gold);animation:scanline 1.8s linear infinite;z-index:0;pointer-events:none}
  .cer-title{font-family:'Orbitron',monospace;font-size:clamp(14px,4vw,20px);font-weight:900;color:var(--gold-l);margin-bottom:4px;animation:pulse 2.5s infinite;letter-spacing:1.5px}
  .terminal{background:rgba(0,0,0,.75);border:1px solid rgba(245,158,11,.26);border-radius:11px;padding:14px;text-align:left;margin:14px 0;font-family:'Share Tech Mono',monospace;font-size:11px;line-height:1.85;min-height:160px;overflow-y:auto;max-height:280px}
  .t-hdr{display:flex;gap:5px;margin-bottom:8px;align-items:center}
  .td{width:8px;height:8px;border-radius:50%}.td-r{background:#ff5f56}.td-y{background:#ffbd2e}.td-g{background:#27c93f}
  .t-ttl{font-size:9px;color:rgba(255,255,255,.3);margin-left:4px}
  .tlog .tline{margin-bottom:2px}
  .tc{color:var(--gold-l)}.ts{color:#4ade80}.tw{color:#fbbf24}
  .cur{display:inline-block;width:6px;height:11px;background:var(--gold);animation:pulse .8s infinite;vertical-align:middle}

  /* RESULT */
  #result-screen{justify-content:flex-start;padding-top:16px}
  .result-wrap{width:100%;max-width:1060px}
  .result-hero{text-align:center;margin-bottom:14px}
  .result-title{font-family:'Orbitron',monospace;font-size:clamp(12px,3.5vw,18px);color:var(--gold-l);letter-spacing:1.5px;margin-bottom:3px}
  .rank-strip{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;margin-bottom:14px}
  @media(max-width:480px){.rank-strip{flex-wrap:nowrap;overflow-x:auto;justify-content:flex-start;padding:4px 2px 8px;scrollbar-width:none;-ms-overflow-style:none}.rank-strip::-webkit-scrollbar{display:none}}
  .rp{padding:7px 12px;border-radius:16px;font-family:'Orbitron',monospace;font-size:9px;font-weight:700;cursor:pointer;transition:all .2s;border:2px solid transparent;white-space:nowrap;flex-shrink:0;min-height:36px;display:flex;align-items:center}
  .rp.active{transform:scale(1.05)}
  .rp1{background:rgba(245,158,11,.17);border-color:var(--gold);color:var(--gold-l)}.rp1.active{background:rgba(245,158,11,.35);box-shadow:0 0 12px rgba(245,158,11,.4)}
  .rp2{background:rgba(139,92,246,.12);border-color:var(--purple);color:var(--purple-l)}.rp2.active{background:rgba(139,92,246,.26);box-shadow:0 0 10px rgba(139,92,246,.35)}
  .rp3{background:rgba(59,130,246,.1);border-color:var(--blue);color:#93c5fd}.rp3.active{background:rgba(59,130,246,.2);box-shadow:0 0 10px rgba(59,130,246,.3)}
  .result-grid{display:grid;grid-template-columns:280px 1fr;gap:14px;margin-bottom:16px}
  @media(max-width:820px){.result-grid{grid-template-columns:1fr}}
  .path-res-card{padding:22px 18px;border-radius:18px;text-align:center;position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:center;gap:9px}
  .path-res-card::before{content:'';position:absolute;top:-40%;left:-40%;width:180%;height:180%;background:radial-gradient(ellipse,var(--hc,#f59e0b) 0%,transparent 65%);opacity:.07;pointer-events:none}
  @media(max-width:820px){.path-res-card{flex-direction:row;text-align:left;padding:16px 18px;gap:14px;align-items:flex-start}.path-res-card .res-emblem{flex-shrink:0}.prc-right{flex:1;min-width:0}}
  .res-emblem{animation:float 3s ease-in-out infinite}
  @media(max-width:820px){.res-emblem svg{width:68px!important;height:68px!important}}
  .res-concept-big{font-family:'Orbitron',monospace;font-size:clamp(12px,3vw,16px);font-weight:900;letter-spacing:.8px;line-height:1.3;margin-top:2px}
  .res-tagline{font-size:clamp(11px,3vw,12px);color:rgba(255,255,255,.62);line-height:1.65}
  .prob-list{width:100%;text-align:left;margin-top:2px}
  .prob-list-title{font-family:'Orbitron',monospace;font-size:8px;letter-spacing:1.5px;margin-bottom:6px;opacity:.55}
  .prob-item{display:flex;align-items:flex-start;gap:6px;margin-bottom:5px;font-size:clamp(11px,3vw,12px);line-height:1.5;color:rgba(255,255,255,.73)}
  .prob-dot{width:4px;height:4px;border-radius:50%;flex-shrink:0;margin-top:5px}
  .detail-panel{display:flex;flex-direction:column;gap:11px}
  .courses-panel{padding:16px;border-radius:13px}
  .cp-title{font-family:'Orbitron',monospace;font-size:8px;letter-spacing:1.5px;margin-bottom:10px}
  .ci{display:flex;flex-direction:column;padding:12px 14px;border-radius:11px;margin-bottom:8px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);transition:all .2s;text-decoration:none;animation:slideIn .3s ease both;cursor:pointer;position:relative;overflow:hidden}
  .ci::before{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.04),transparent);transition:left .4s}
  .ci:hover::before{left:100%}
  @media(min-width:481px){.ci:hover{transform:translateX(4px);background:rgba(255,255,255,.07)}}
