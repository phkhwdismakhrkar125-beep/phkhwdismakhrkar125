───────────────────────────────────── */
function buildExplorer(){
  const g=document.getElementById('exp-grid');if(g.innerHTML.trim())return;
  const cfgs=[{key:'automation',cls:'ec-a',color:'#a78bfa',glow:'#8b5cf6'},{key:'insight',cls:'ec-i',color:'#67e8f9',glow:'#06b6d4'},{key:'km',cls:'ec-k',color:'#93c5fd',glow:'#3b82f6'}];
  g.innerHTML=cfgs.map(cfg=>{
    const p=PATHS[cfg.key],cs=COURSES[cfg.key];
    return `<div class="exp-card ${cfg.cls}">
      <div class="ec-icon">${p.icon}</div>
      <div class="ec-name" style="color:${cfg.color}">${p.name}</div>
      <div class="ec-concept">${p.key==='automation'?'Autonomous Process':p.key==='insight'?'Better Decision':'Virtual Expert'}</div>
      <div class="ec-tagline">${p.tagline}</div>
      <div style="font-family:'Orbitron',monospace;font-size:7px;letter-spacing:1.5px;color:${cfg.color};margin-bottom:5px;opacity:.6">📋 ${cs.length} หลักสูตร</div>
      <div class="ec-courses">${cs.map(c=>`<a class="ec-c" href="${c.url}" target="_blank" rel="noopener" onmouseenter="sndLnk()"><span class="ec-c-name">${c.icon} ${c.name}</span><span class="ec-c-go" style="color:${cfg.color}">→</span></a>`).join('')}</div>
    </div>`;
  }).join('');
}

function resetAll(){sndClick();qIdx=0;answers=[null,null,null];scores={automation:0,insight:0,km:0};winner='';goScreen('welcome');}

window.addEventListener('DOMContentLoaded',()=>{
  document.getElementById('welcome-screen').classList.add('active');
  updateFooterStats();
});
