        <div style="font-family:'Orbitron',monospace;font-size:8px;letter-spacing:1.5px;color:${p.color};opacity:.5;margin-bottom:3px">${rankLbls[ri]}</div>
        <div class="badge ${p.badgeClass}" style="margin-bottom:5px">${p.thName}</div>
        <div class="res-concept-big" style="color:${p.color}">${p.name}</div>
        <div class="res-tagline">${p.tagline}</div>
        <div class="prob-list"><div class="prob-list-title" style="color:${p.color}">✦ ${p.probTitle}</div>${probItems}</div>
      </div>
    </div>
    <div class="detail-panel">
      <div class="courses-panel glass" style="border-color:${p.glow}24">
        <div class="cp-title" style="color:${p.color}">📋 หลักสูตรแนะนำ — แตะเพื่อเรียนได้เลย (${cs.length} วิชา)</div>
        ${courseItems}
      </div>
    </div>`;
}

